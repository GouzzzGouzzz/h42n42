opam-version: "2.0"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.10" & >= "3.10"}
  "eliom" {>= "10.0"}
  "js_of_ocaml" {>= "5.0"}
  "js_of_ocaml-ppx"
  "js_of_ocaml-lwt"
  "lwt"
  "lwt_ppx"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
